
using std;

std.version();

extern "asm" func _start(*func(...) -> int) -> int:
	// write yor asm basic is x86-64 linux put "ARM asm" for arm etc...
	mov rax, 60
	xor rdi, rdi
	syscall

class foo:
	public:
		func methode():
			print("int methode");
	private
		...;

func main(void) -> int:
	int: i = 0;
	string: s;

	if s == "" do:
		print("hello!");
	elif s != "" do:
		print("hallo!");
	else:
		print("what happened?");
		return (1);
	foo.methode()
	while i < 10 do:
		print("this is i -> :", i++);
	return (0);

_start(&main); // if you want argc argv and envp

main(); // if nothing then you have full control you can write your own _start

